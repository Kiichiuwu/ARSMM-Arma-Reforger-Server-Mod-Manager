{
  "name": "compilador",
  "version": "1.0.0",
  "description": "Arma Reforger Server Mod Manager - gerenciador de perfis, mods, RCON e monitoramento para servidores de Arma Reforger",
  "main": "main.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder --publish=never"
  },
  "keywords": [],
  "author": "Kiichiuwu",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.armareforgermanager.app",
    "productName": "Arma Reforger Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "backend/**/*.js",
      "index.html",
      "setup.html"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
